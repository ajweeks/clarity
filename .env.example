# Copy to .env and fill in. .env is gitignored; never commit it.

# LLM provider key (Anthropic by default; OPENAI_API_KEY also works)
ANTHROPIC_API_KEY=

# Password for the login screen
CLARITY_PASSWORD=

# Cloudflare Turnstile widget keys (Cloudflare dashboard > Turnstile > Add widget,
# hostname: clarity.ajweeks.com). For local testing you can use the always-pass
# test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs login cookies. Generated automatically by scripts/start_server.sh if left empty.
CLARITY_SESSION_SECRET=

# Optional
# CLARITY_SESSION_DAYS=30
# CLARITY_MAX_FAILED_LOGINS=10
# CLARITY_TUNNEL=clarity
